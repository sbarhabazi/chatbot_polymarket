# === Mode ===
PAPER_TRADING=true
PAPER_BALANCE=100.00

# === Wallet ===
PRIVATE_KEY=0x...
WALLET_ADDRESS=0x...

# === Polygon RPC ===
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# === Entry Rules (Early Entry: 60-120s before close) ===
ENTRY_WINDOW_SECONDS=120
MAX_BUY_PRICE=0.90
ABORT_PRICE=0.99
MIN_MARKET_LIQUIDITY=1000

# === Distance Strategy ===
MIN_BTC_DISTANCE=12.0
VOLATILITY_THRESHOLD=0.005
MOMENTUM_CONFIRMATION_REQUIRED=0

# === Confidence-Based Sizing (reduced for early entry risk) ===
HIGH_CONFIDENCE_THRESHOLD=0.72
MEDIUM_CONFIDENCE_THRESHOLD=0.60
HIGH_CONFIDENCE_SIZE=0.30
MEDIUM_CONFIDENCE_SIZE=0.20
POSITION_SIZE_FRACTION=0.30

# === Harvester ===
HARVEST_POLL_INTERVAL=30
MAX_RECENT_MARKETS_TO_CHECK=20
